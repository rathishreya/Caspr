flowchart LR

SRC["<b>ONE VERIFIED FINDING</b><br/><i>a number, its unit, its period,<br/>its publisher — from ⑤</i>"]

SRC --> BRIEF["<b>⑧ WORK ORDER ROW</b><br/>type · ICP · narrative · stage<br/>channel · format · slot"]
BRIEF --> CTX["<b>⑨ ASSEMBLY</b> — 9 context blocks<br/>the finding · canonical facts (⑲)<br/>voice lane · active failure modes (⑭)<br/>ICP language · the brief"]

CTX --> W{"<b>⑩ WRITER</b><br/>which tier?"}
W -->|"takes a position"| FR["<b>FRONTIER MODEL</b> · ~20%<br/>analysis framing · search answers<br/>founder posts · outreach"]
W -->|"transforms"| HK["<b>CHEAP MODEL</b> · ~80%<br/>voiced variants · threads · metadata<br/><i>this split is what keeps<br/>the bill at $40–100/month</i>"]

FR --> ART
HK --> ART

subgraph ART["EVERY ARTEFACT, AND HOW IT IS MADE"]
  T1["<b>BLOG / SEARCH ANSWER</b><br/>900–1,800 words<br/>1 hero + 1–2 charts<br/>3–5 internal links<br/><i>question sourced from Quora/forum demand</i>"]
  T2["<b>PUBLISHED ANALYSIS</b><br/>the full report + a web standfirst<br/>cover + the atom<br/><i>1 per 3 weeks</i>"]
  T3["<b>LINKEDIN POST</b><br/>1,200–1,800 chars<br/><b>hook in the first 2 lines</b><br/><i>the rest is behind 'see more'</i>"]
  T4["<b>X POST / THREAD</b><br/>≤280 each · thread 4–7"]
  T5["<b>CAROUSEL / DOCUMENT</b><br/><i>the evidenced best format —<br/>2,945 impressions on the<br/>document-attached post</i>"]
  T6["<b>THE ATOM</b> + social cards<br/>1080×1080, dark ground<br/><i>1 atom + 1–3 cards per analysis</i>"]
  T7["<b>EMAIL BLOCK</b><br/>120–300 words · 1 CTA"]
  T8["<b>COMMUNITY DRAFT</b><br/><i>native to the thread.<br/>⛔ NO template shape</i>"]
end

subgraph MICRO["THE SMALL PARTS — not written per post"]
  C1["<b>CAPTION</b><br/><i>there is no separate caption.<br/>on social the BODY COPY is the caption —<br/>written once, to the channel's length</i>"]
  C2["<b>HASHTAGS</b><br/><i>from the CHANNEL RULE, not invented:</i><br/>LinkedIn <b>0–3</b>, lowercase<br/>X <b>0–1</b> · community <b>none</b><br/>⛔ <b>never trending-jacked</b>"]
  C3["<b>THE LINK</b><br/>⭐ <code>utm_content = item id</code><br/>+ icp_hint<br/><i>LinkedIn: in the FIRST COMMENT,<br/>never the body — a body link<br/>suppresses reach</i>"]
  C4["<b>THE RED DOT</b><br/><i>placed by measuring the rendered<br/>text, not a fixed coordinate</i>"]
end

subgraph VID["VIDEO / REELS — ⛔ PARTLY OUT OF SCOPE"]
  V1["✅ the engine writes<br/>the <b>script, hook and caption</b>"]
  V2["⛔ the engine does <b>NOT</b> produce video<br/><i>'video editing — the DM team's<br/>editor owns this'</i>"]
  V3["the engine may REFERENCE a<br/>produced video, and the page<br/>carrying it gets VideoObject schema"]
  V1 --> V2 --> V3
end

ART --> MICRO
ART --> VID

MICRO --> VIS["<b>⑪ VISUAL DESK</b><br/>chart data from Caspr →<br/>HTML template → headless Chromium → PNG<br/><i>fonts ship with the renderer, or every<br/>card silently falls back to Georgia</i>"]

VIS --> LINT["<b>⑫ LINTER</b>"]
LINT --> REV["<b>⑬ REVIEW</b> — a person"]

OVER["⛔ <b>VISUAL_OVERFLOW</b><br/><i>headline one character too long →<br/>the dot lands inside the last letter.<br/>the item is NOT PRODUCED —<br/>the linter reads text, not pixels</i>"]
VIS -.-> OVER

classDef mach fill:#f5f4f2,stroke:#3c3c3a,stroke-width:1.5px,color:#1a1a19
classDef hum fill:#e3f2fd,stroke:#1565c0,stroke-width:2.5px,color:#0d47a1
classDef stop fill:#37474f,stroke:#263238,stroke-width:2px,color:#ffffff
classDef warn fill:#fff8e1,stroke:#f9a825,stroke-width:2px,color:#7f5f00
classDef good fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1b5e20
class SRC,BRIEF,CTX,FR,HK,T1,T2,T3,T4,T6,T7,VIS,LINT,V1,V3 mach
class W,REV hum
class OVER,V2,C2 stop
class C1,C3,C4 warn
class T5,T8 good
