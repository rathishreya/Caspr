# Names only. Never values.
#
# CLAUDE.md Rule 7 and build spec §7: every secret lives in AWS Secrets Manager and is
# injected at runtime. Nothing in this repo holds a live credential, and `.gitignore`
# refuses every env file except this one.
#
# Absent DATABASE_URL, the console serves the 23-item reference week from the
# specification rather than failing — see build spec §0 on building against mocks behind
# a real interface.

# Postgres (Aurora Serverless v2). Injected from Secrets Manager.
DATABASE_URL=

# The text-hygiene service (CLAUDE.md Rule 6). Publishing is halted while it is
# unreachable — approved items are HELD, not dropped.
WATERMARKS_SERVICE_URL=

# Cognito. There is no signup page; invite from Admin is the only route in.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=
