node_modules/
.next/

# Generated by Next, and its contents differ between `dev` and `build` — committing it
# guarantees a dirty tree after whichever command ran second.
next-env.d.ts

out/
dist/
*.tsbuildinfo
coverage/

# Secrets never enter this repo — portal-build-spec.md §7, CLAUDE.md Rule 7.
# Runtime configuration comes from AWS Secrets Manager. .env.example is the only
# committed env file, and it holds names, never values.
.env
.env.*
!.env.example
